# Copy this file to scripts/deploy-remote.env and fill in your real values.

# Required
SSH_TARGET="ubuntu@example.com"
APP_DIR="/var/www/NotionNext"

# Git
BRANCH="main"
REMOTE_NAME="origin"

# If your server deploys from a branch that is not on origin yet, set this to true.
# The script will push local HEAD to PUSH_REMOTE/PUSH_BRANCH before SSH deployment.
PUSH_BEFORE_DEPLOY="false"
PUSH_REMOTE="origin"
PUSH_BRANCH="main"

# Safety
ALLOW_DIRTY_REMOTE="false"
SYNC_NEXT_PUBLIC_VERSION="false"

# Remote commands
PRE_DEPLOY_CMD=":"
INSTALL_CMD="yarn install --frozen-lockfile"
BUILD_CMD="yarn build"

# Pick one restart style and replace the placeholder.
# Examples:
# RESTART_CMD="pm2 restart notionnext"
# RESTART_CMD="sudo systemctl restart notionnext"
# RESTART_CMD="cd /opt/notionnext && docker compose up -d --build"
RESTART_CMD="pm2 restart notionnext"

POST_DEPLOY_CMD=":"
HEALTHCHECK_CMD="curl -fsS http://127.0.0.1:3000 >/dev/null"
